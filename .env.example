# AI provider credentials are read on the server only.
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=
# Optional alternatives: AI_PROVIDER=openai with OPENAI_API_KEY,
# or AI_PROVIDER=openai-compatible with AI_API_KEY, AI_BASE_URL, and AI_MODEL.
OPENAI_API_KEY=
# For an OpenAI-compatible provider, set AI_PROVIDER=openai-compatible, AI_API_KEY,
# AI_BASE_URL and AI_MODEL. The endpoint must support the Responses API.
AI_API_KEY=
AI_BASE_URL=
# Maximum input size accepted by the rewrite API (characters).
MAX_INPUT_CHARS=30000
